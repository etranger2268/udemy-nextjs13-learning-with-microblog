{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "json-server": "json-server --watch src/test-data/articles.json --port 3001",
    "dev:all": "concurrently \"npm run dev\" \"npm run json-server\"",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "clean": "rm -rf .next",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
